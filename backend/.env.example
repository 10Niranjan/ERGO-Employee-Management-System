# =============================================================================
# Ergo Employee Management System — Backend Environment Configuration Example
# Copy this file to .env and provide your environment-specific credentials.
# DO NOT commit .env with production credentials to version control.
# =============================================================================

# ─── Server Configuration ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
TZ=Asia/Kolkata

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ergo_employee_management
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
# Optional Database Connection Pool tuning
DB_MAX_CLIENTS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate a cryptographically secure string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=8h

# ─── Cryptography ────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS Policy ─────────────────────────────────────────────────────────────
# Set to the production domain when deploying (e.g. https://hrms.yourcompany.com)
FRONTEND_URL=http://localhost:5173

# ─── Password-reset OTP hashing ──────────────────────────────────────────────
# Keyed HMAC pepper for admin reset codes. Falls back to JWT_SECRET if unset,
# but set it independently in production so rotating one doesn't invalidate
# the other. Generate with `openssl rand -hex 32`.
OTP_PEPPER=

# ─── Outbound email (admin reset codes + password-change confirmations) ──────
# If SMTP_HOST is empty in development, emails are printed to the server
# console instead so the OTP flow is testable without credentials.
# In production a missing SMTP_HOST is a hard error — a reset code that
# silently fails to send would strand the admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ERGO Management <no-reply@ergo-asia.co>
SUPPORT_EMAIL=it@ergo-asia.co
