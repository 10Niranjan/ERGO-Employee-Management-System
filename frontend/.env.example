# Frontend Environment Variables
# Copy this file to .env and fill in your actual values.

# Backend API origin (used by axiosClient.js — no trailing slash, no /api suffix).
# Leave EMPTY for local dev: Vite's dev-server proxy (vite.config.js) already
# forwards relative /api/* requests to the backend, so axios's baseURL falls
# back to '/api' and just works. Only set this once frontend and backend are
# deployed to different origins (e.g. backend on its own Vercel project) —
# then point it at that backend's real URL, e.g. https://ergo-backend.vercel.app
VITE_API_BASE_URL=
